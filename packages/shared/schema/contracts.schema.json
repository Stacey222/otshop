{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "OTShop shared cross-boundary contracts",
  "contractVersion": 2,
  "$defs": {
    "ApiErrorEnvelope": {
      "$schema": "https://json-schema.org/draft/2020-12/schema",
      "type": "object",
      "properties": {
        "error": {
          "type": "object",
          "properties": {
            "category": {
              "type": "string",
              "enum": [
                "RETRYABLE",
                "NON_RETRYABLE",
                "MANUAL_REVIEW_REQUIRED"
              ]
            },
            "code": {
              "type": "string",
              "pattern": "^[A-Z][A-Z0-9_]{2,127}$"
            },
            "details": {
              "type": "array",
              "items": {
                "type": "object",
                "properties": {
                  "code": {
                    "type": "string",
                    "pattern": "^[A-Z][A-Z0-9_]{2,127}$"
                  },
                  "field": {
                    "type": "string",
                    "minLength": 1,
                    "maxLength": 200
                  },
                  "message": {
                    "type": "string",
                    "minLength": 1,
                    "maxLength": 500
                  }
                },
                "required": [
                  "code",
                  "field",
                  "message"
                ],
                "additionalProperties": false
              }
            },
            "message": {
              "type": "string",
              "minLength": 1,
              "maxLength": 500
            },
            "requestId": {
              "type": "string",
              "allOf": [
                {
                  "pattern": "^([0-9a-fA-F]{8}-[0-9a-fA-F]{4}-7[0-9a-fA-F]{3}-[89abAB][0-9a-fA-F]{3}-[0-9a-fA-F]{12})$"
                },
                {
                  "pattern": "^[0-9a-f-]+$"
                }
              ],
              "description": "RequestId"
            },
            "retryable": {
              "type": "boolean"
            }
          },
          "required": [
            "category",
            "code",
            "message",
            "requestId",
            "retryable"
          ],
          "additionalProperties": false
        }
      },
      "required": [
        "error"
      ],
      "additionalProperties": false
    },
    "DatasetId": {
