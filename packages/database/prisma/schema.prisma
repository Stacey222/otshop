  action         String        @db.Text
  resourceType   String        @map("resource_type") @db.Text
  resourceId     String        @map("resource_id") @db.Uuid
  requestId      String        @map("request_id") @db.Uuid
  beforeData     Json?         @map("before_data") @db.JsonB
  afterData      Json?         @map("after_data") @db.JsonB
  ipPrefix       String?       @map("ip_prefix") @db.Text
  createdAt      DateTime      @default(now()) @map("created_at") @db.Timestamptz(3)
  workspace      Workspace?    @relation(fields: [workspaceId], references: [id], onDelete: SetNull)
  organization   Organization? @relation(fields: [organizationId], references: [id], onDelete: SetNull)

  @@index([workspaceId, createdAt], map: "audit_logs_workspace_created_idx")
  @@index([actorId, createdAt], map: "audit_logs_actor_created_idx")
  @@index([resourceType, resourceId], map: "audit_logs_resource_idx")
  @@map("audit_logs")
}

model OutboxEvent {
  id            String     @id @db.Uuid
  workspaceId   String?    @map("workspace_id") @db.Uuid
  topic         String     @db.Text
  aggregateType String     @map("aggregate_type") @db.Text
  aggregateId   String     @map("aggregate_id") @db.Uuid
  payload       Json       @db.JsonB
  createdAt     DateTime   @default(now()) @map("created_at") @db.Timestamptz(3)
  availableAt   DateTime   @map("available_at") @db.Timestamptz(3)
  publishedAt   DateTime?  @map("published_at") @db.Timestamptz(3)
  attemptCount  Int        @default(0) @map("attempt_count")
  lastError     String?    @map("last_error") @db.Text
  workspace     Workspace? @relation(fields: [workspaceId], references: [id], onDelete: SetNull)

  @@index([publishedAt, availableAt], map: "outbox_events_dispatch_idx")
  @@index([workspaceId], map: "outbox_events_workspace_idx")
  @@map("outbox_events")
}

model WorkspaceDispatchState {
  workspaceId      String    @id @map("workspace_id") @db.Uuid
  lastDispatchedAt DateTime? @map("last_dispatched_at") @db.Timestamptz(3)
  dispatchCount    BigInt    @default(0) @map("dispatch_count") @db.BigInt
  version          Int       @default(1)
  updatedAt        DateTime  @updatedAt @map("updated_at") @db.Timestamptz(3)
  workspace        Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)

  @@map("workspace_dispatch_state")
}

model SystemSetting {
  key             String   @id @db.Text
  value           Json     @db.JsonB
  schemaVersion   Int      @map("schema_version")
  updatedByUserId String   @map("updated_by_user_id") @db.Uuid
  createdAt       DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt       DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)
  updatedBy       User     @relation(fields: [updatedByUserId], references: [id], onDelete: Restrict)

  @@index([updatedByUserId], map: "system_settings_updater_idx")
  @@map("system_settings")
}

model WorkspaceSetting {
  workspaceId     String    @map("workspace_id") @db.Uuid
  key             String    @db.Text
  value           Json      @db.JsonB
  schemaVersion   Int       @map("schema_version")
  updatedByUserId String    @map("updated_by_user_id") @db.Uuid
  createdAt       DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt       DateTime  @updatedAt @map("updated_at") @db.Timestamptz(3)
  workspace       Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  updatedBy       User      @relation(fields: [updatedByUserId], references: [id], onDelete: Restrict)

  @@id([workspaceId, key])
  @@index([updatedByUserId], map: "workspace_settings_updater_idx")
  @@map("workspace_settings")
}
