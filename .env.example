# Architecture-approved placeholders. Copy to .env only when implementation requires it.
DATABASE_URL=postgresql://otshop:change-me@localhost:5432/otshop
# Database integration commands reject targets unless the database or schema name ends in _test.
TEST_DATABASE_URL=postgresql://otshop_test:change-me@localhost:5432/otshop_test
APP_URL=http://localhost:3000
STORAGE_ROOT=./storage
MAX_MEDIA_UPLOAD_BYTES=268435456
FFPROBE_EXECUTABLE=ffprobe
FFPROBE_TIMEOUT_MS=15000
FFPROBE_MAX_OUTPUT_BYTES=262144
LOG_LEVEL=info
APP_VERSION=0.0.0

# Conservative feature defaults
ENABLE_SHOPEE_ANDROID=false
ENABLE_SHOPEE_OFFICIAL_API=false
ENABLE_REAL_PUBLISH=false
ENABLE_SCHEDULER=false
ENABLE_WORKER_PROTOCOL=false
ALLOW_REAL_PUBLISH=false
